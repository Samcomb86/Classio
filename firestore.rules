rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The public can read only the latest timetable document.
    // Nobody can write from the client.
    match /timetableVersions/latest {
      allow read: if true;
      allow write: if false;
    }

    // Historical versions cannot be read or written directly from the client.
    match /timetableVersions/{versionId} {
      allow read: if false;
      allow write: if false;
    }

    // Ingest logs can only be read or written by server code via Firebase Admin SDK.
    match /ingestLogs/{logId} {
      allow read, write: if false;
    }

    // User profile sync collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
